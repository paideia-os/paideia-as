//! #1196: flat-lambda BinOp canary: (Literal, Var) bitwise OR
//! Pattern: fn (v) -> 4 | v
//! Before #1196: silently miscompiled as 4 + v
//! After #1196: correctly emits OR instruction via shared lowerer

module FlatLambdaBinopOrLitVar = structure {
  let compute : (u64) -> u64 =
    fn (v: u64) -> 4 | v

  pub let entry : () -> u64 =
    fn () -> compute(1)
}
