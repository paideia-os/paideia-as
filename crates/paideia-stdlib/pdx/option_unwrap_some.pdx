// Phase 4 m11-001 (v0.18 #997): Option<T> fixture — unwrap on Some.
//
// Demonstrates unwrap behavior on Some variant.
// Uses concrete OptionU64 monomorphization pending #997c.

module OptionUnwrapSome = structure {
  enum OptionU64 { Some(u64), None }
  pub let entry : () -> u64 !{} @{} = fn(_: ()) -> {
    let x : OptionU64 = OptionU64::Some(42u64)
    match x {
      Some(n) => n,
      None    => 0u64,
    }
  }
}
