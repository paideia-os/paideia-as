// Issue #1001: or_pat_enum_unit_second
// Tests or-pattern matching with enum unit variants (second alt matches)
// Expected exit code: 1

module OrPatEnumUnitSecond = structure {
  enum Choice { A, B, C }
  pub let c : Choice = Choice::B
  pub let entry : () -> u64 !{} @{} = fn(_ : ()) -> {
    match c {
      A | B => 1u64
      C => 2u64
    }
  }
}
