// Issue #1225: nested BinOp arg1 scratch pool (ARG1_SCRATCHES=[R10,R11])
// must respect live pattern-binder registers. When RCX+R8 are live from
// prior lets, the pattern-binder pool [RCX,R8,R10,R11] filters to
// [R10,R11] and v lands in R10. The outer BinOp arg1_dest then aliases v.
// Inner (v+1) writes 1 into R10, clobbering v before the outer arg1=v
// re-reads it.
//
// Before #1225: 5 (v clobbered → (3+1)+1)
// After  #1225: 7 (arg1_dest filtered to R11, v preserved in R10 → (3+1)+3)
// Expected exit code: 7

module BinopArg1ScratchRespectsPatternBinder = structure {
  enum Choice { A(u64), B }
  pub let entry : () -> u64 !{} @{} = fn(_: ()) -> {
    let s : Choice = Choice::A(3u64)
    let _x : u64 = 42u64
    match s {
      A(v) => {
        let r : u64 = (v + 1u64) + v
        r
      }
      _ => 0u64
    }
  }
}
