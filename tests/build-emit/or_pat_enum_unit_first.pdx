// Issue #1001: or_pat_enum_unit_first
// Tests or-pattern matching with enum unit variants (first alt matches)
// Expected exit code: 1

module OrPatEnumUnitFirst = structure {
  enum Choice { A, B, C }
  pub let c : Choice = Choice::A
  pub let entry : () -> u64 !{} @{} = fn(_ : ()) -> {
    match c {
      A | B => 1u64
      C => 2u64
    }
  }
}
