// v0.33 hw-smoke: Argon2id + ChaCha20-Poly1305 + ML-KEM-768 KAT vectors
// (paideia-as#1394).
//
// Companion to design/../tools/hw-smoke-v0.33.md. Boots under QEMU via
// the harness in tests/hw-smoke-crypto/ and proves that the three v0.33
// crypto primitives reproduce their spec vectors byte-for-byte when
// invoked through the REAL .pdx -> extern-C FFI-thunk call boundary
// (stdlib_lowering::cryptoops), not merely via `cargo test` on the host.
//
// KAT byte constants below are transcribed mechanically (via a small
// generator script, not by hand) from the single-source-of-truth Rust
// constants in crates/paideia-as-crypto/src/{kdf,aead,kem}/*.rs, so a
// vector drift between the Rust host tests and this hw-smoke would be
// a copy/paste bug in the generator rather than a divergent hand-typed
// transcription. Byte values are unchanged from those Rust `pub const`
// declarations.
//
// Spec sources (see tools/hw-smoke-v0.33.md Sec.6 for the full list):
//   - RFC 9106 Sec.5.3        (Argon2id canonical test vector)
//   - RFC 8439 Sec.2.8.2      (ChaCha20-Poly1305 canonical AEAD vector)
//   - FIPS 203 Sec.6, Sec.7   (ML-KEM-768 KeyGen/Encaps/Decaps)
//   - NIST ACVP-Server commit 65370b8, ML-KEM-{keyGen,encapDecap}-FIPS203
//
// Per-probe pass -> `HWSMOKE_KAT_OK_<...>` on COM1 (0x3F8); fail ->
// `HWSMOKE_KAT_FAIL_<...>`. All six pass -> aggregate
// `HWSMOKE_KAT_OK_V0_33_ALL`. Simplification vs. the design doc: the
// FAIL markers here are fixed strings (no dynamic mismatch-offset
// payload) -- formatting a byte offset to hex has no stdlib primitive
// wired yet, so the boot-smoke signal is "which primitive failed",
// not "which byte". Full binary-diff diagnostics remain the host-side
// `cargo test -p paideia-as-crypto` suite's job.
//
// Grammar note (issue #1077/#1088): unsafe blocks in this compiler
// accept ONLY raw asm mnemonics + labels + zero-arg call-expression
// statements (`StmtLet`/`StmtWhile`/`StmtIf` inside `unsafe` still
// fire U1614). All branching/looping/let-binding below therefore lives
// in ordinary (non-`unsafe`) functions; every `unsafe` block in this
// file is pure straight-line asm, mirroring
// tests/build-emit/boot_observable.pdx.

module HwSmokeCryptoV033 = structure {
  // -------------------------------------------------------------
  // stdlib trait surfaces (mirrors crates/paideia-as-stdlib/pdx/
  // crypto/{argon2id,chacha20_poly1305,ml_kem_768}.pdx and bytes.pdx;
  // stdlib_lowering dispatches on trait-name/method-name text, so
  // redeclaring the signatures inline here -- rather than importing --
  // matches the only precedent for a stdlib trait call in this corpus,
  // tests/build-emit/trait_call_lambda_body.pdx).
  // -------------------------------------------------------------

  trait Argon2id {
    fn derive(params_ptr: u64, out_ptr: u64, out_len: u64) -> i64 !{crypto, mem} @{paideia.crypto};
  }

  trait ChaCha20Poly1305 {
    fn seal(
      params: u64,
      plaintext_ptr: u64,
      plaintext_len: u64,
      out_ptr: u64,
      out_cap: u64,
      written_ptr: u64,
    ) -> i64 !{crypto, mem} @{paideia.crypto};

    fn open(
      params: u64,
      sealed_ptr: u64,
      sealed_len: u64,
      out_ptr: u64,
      out_cap: u64,
      written_ptr: u64,
    ) -> i64 !{crypto, mem} @{paideia.crypto};
  }

  trait MlKem768 {
    fn keygen(seed_d_ptr: u64, seed_z_ptr: u64, ek_out_ptr: u64, dk_out_ptr: u64) -> i64 !{crypto, mem} @{paideia.crypto};
    fn encaps(ek_ptr: u64, seed_m_ptr: u64, ct_out_ptr: u64, ss_out_ptr: u64) -> i64 !{crypto, mem} @{paideia.crypto};
    fn decaps(dk_ptr: u64, ct_ptr: u64, ss_out_ptr: u64) -> i64 !{crypto, mem} @{paideia.crypto};
  }

  trait BytesOps {
    fn get_u8(buf: u64, off: u64) -> u8 !{RawMem} @{paideia.raw_mem};
  }

  // -------------------------------------------------------------
  // Argon2id -- RFC 9106 Sec.5.3
  // -------------------------------------------------------------

  // Inputs are fixed-value byte repeats per the RFC vector table.
  pub let argon2id_password : [u8; 32] = [0x01; 32]
  pub let argon2id_salt : [u8; 16] = [0x02; 16]
  pub let argon2id_secret : [u8; 8] = [0x03; 8]
  pub let argon2id_ad : [u8; 12] = [0x04; 12]

  pub let RFC_9106_ARGON2ID_TAG : [u8; 32] = [
    0x0d, 0x64, 0x0d, 0xf5, 0x8d, 0x78, 0x76, 0x6c, 0x08, 0xc0, 0x37, 0xa3, 0x4a, 0x8b, 0x53, 0xc9,
    0xd0, 0x1e, 0xf0, 0x45, 0x2d, 0x75, 0xb6, 0x5e, 0xb5, 0x25, 0x20, 0xe9, 0x6b, 0x01, 0xe6, 0x59,
  ]
  // Argon2idParamsC blob -- field order + widths MUST match
  // crates/paideia-as-crypto/src/ffi/argon2id.rs::Argon2idParamsC
  // exactly (this IS the boundary the hw-smoke exists to pin):
  //   [password_ptr, password_len, salt_ptr, salt_len, secret_ptr,
  //    secret_len, ad_ptr, ad_len, (m_cost_kib|t_cost<<32),
  //    (p_cost|_reserved<<32)]
  // The last two u64 words are the two trailing u32-pairs of the
  // #[repr(C)] struct, precomputed by hand (not by compiler constant-
  // folding, which is unproven for arithmetic inside a static array
  // initializer in this corpus) as little-endian-packed literals:
  //   m_cost_kib=32 (0x20), t_cost=3   -> 0x0000000300000020
  //   p_cost=4,            _reserved=0 -> 0x0000000000000004
  let argon2id_params : [u64; 10] = [
    &argon2id_password, 32,
    &argon2id_salt, 16,
    &argon2id_secret, 8,
    &argon2id_ad, 12,
    0x0000000300000020, 0x0000000000000004
  ]

  let mut argon2id_out : [u8; 32] = [0; 32]

  // -------------------------------------------------------------
  // ChaCha20-Poly1305 -- RFC 8439 Sec.2.8.2
  // -------------------------------------------------------------

  pub let RFC_8439_SEC_2_8_2_KEY : [u8; 32] = [
    0x80, 0x81, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87, 0x88, 0x89, 0x8a, 0x8b, 0x8c, 0x8d, 0x8e, 0x8f,
    0x90, 0x91, 0x92, 0x93, 0x94, 0x95, 0x96, 0x97, 0x98, 0x99, 0x9a, 0x9b, 0x9c, 0x9d, 0x9e, 0x9f,
  ]

  pub let RFC_8439_SEC_2_8_2_NONCE : [u8; 12] = [
    0x07, 0x00, 0x00, 0x00, 0x40, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46, 0x47,
  ]

  pub let RFC_8439_SEC_2_8_2_AAD : [u8; 12] = [
    0x50, 0x51, 0x52, 0x53, 0xc0, 0xc1, 0xc2, 0xc3, 0xc4, 0xc5, 0xc6, 0xc7,
  ]

  pub let RFC_8439_SEC_2_8_2_PLAINTEXT : [u8; 114] = [
    0x4c, 0x61, 0x64, 0x69, 0x65, 0x73, 0x20, 0x61, 0x6e, 0x64, 0x20, 0x47, 0x65, 0x6e, 0x74, 0x6c,
    0x65, 0x6d, 0x65, 0x6e, 0x20, 0x6f, 0x66, 0x20, 0x74, 0x68, 0x65, 0x20, 0x63, 0x6c, 0x61, 0x73,
    0x73, 0x20, 0x6f, 0x66, 0x20, 0x27, 0x39, 0x39, 0x3a, 0x20, 0x49, 0x66, 0x20, 0x49, 0x20, 0x63,
    0x6f, 0x75, 0x6c, 0x64, 0x20, 0x6f, 0x66, 0x66, 0x65, 0x72, 0x20, 0x79, 0x6f, 0x75, 0x20, 0x6f,
    0x6e, 0x6c, 0x79, 0x20, 0x6f, 0x6e, 0x65, 0x20, 0x74, 0x69, 0x70, 0x20, 0x66, 0x6f, 0x72, 0x20,
    0x74, 0x68, 0x65, 0x20, 0x66, 0x75, 0x74, 0x75, 0x72, 0x65, 0x2c, 0x20, 0x73, 0x75, 0x6e, 0x73,
    0x63, 0x72, 0x65, 0x65, 0x6e, 0x20, 0x77, 0x6f, 0x75, 0x6c, 0x64, 0x20, 0x62, 0x65, 0x20, 0x69,
    0x74, 0x2e,
  ]

  pub let RFC_8439_SEC_2_8_2_CIPHERTEXT : [u8; 114] = [
    0xd3, 0x1a, 0x8d, 0x34, 0x64, 0x8e, 0x60, 0xdb, 0x7b, 0x86, 0xaf, 0xbc, 0x53, 0xef, 0x7e, 0xc2,
    0xa4, 0xad, 0xed, 0x51, 0x29, 0x6e, 0x08, 0xfe, 0xa9, 0xe2, 0xb5, 0xa7, 0x36, 0xee, 0x62, 0xd6,
