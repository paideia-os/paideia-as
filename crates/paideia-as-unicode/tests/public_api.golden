# paideia-as-unicode public API freeze — UNI-11 (paideia-as#1598).
#
# Frozen on 2026-10-11 at crate state covering UNI-0..UNI-10 + UNI-12 + UNI-14.
# Workspace version: 0.37.0 target (freeze precedes bump per spec §1).
#
# Format: `<kind>\t<path>[\t<extras>]` — tab-separated.
# Kinds:
#   mod       module declaration (lib.rs: `pub mod <name>;`)
#   reexport  crate-root re-export (lib.rs: `pub use <path>::<name>;`); extras = source path
#   use       intra-module re-export; extras = source path
#   struct    pub struct definition; extras = attribute tokens (e.g. non_exhaustive)
#   field     pub struct field; extras = type
#   enum      pub enum definition; extras = attribute tokens
#   variant   enum variant; extras = default marker or payload shape
#   fn        pub free function; extras = signature
#   method    pub inherent method; extras = signature
#   impl      trait implementation; extras = `<Trait> for <Type>`
#
# Line-end normalization: CR is stripped and trailing whitespace is removed
# before comparison, so the file survives autocrlf, editor fingerprints, and
# tooling that trims lines.
#
# To regenerate after a reviewed signature change:
#   PAIDEIA_UNICODE_REGEN_API=1 cargo test -p paideia-as-unicode --test public_api_test
#
# Every modification requires: (a) a UNI follow-up ticket per spec §1 freeze
# discipline; (b) an entry in CHANGELOG under the workspace version at the
# time; (c) parallel edits to design/toolchain/paideia-as-unicode-api-freeze.md.

