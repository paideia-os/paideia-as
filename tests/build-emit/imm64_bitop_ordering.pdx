module Imm64BitopOrdering = structure {
  pub let probe : (u64) -> u64 !{sysreg} @{boot} =
    fn (x: u64) -> unsafe {
      effects: {sysreg}, capabilities: {boot},
      justification: "Regression fixture for paideia-as #1249. Exercises imm64 bitop expansion (and rcx, 0x8000000000000000) which used to synthesize movabs+and at hardcoded emission_order=0, placing them BEFORE the probe function's entry symbol. The byte-exact test asserts the movabs is INSIDE the probe function's byte range, not preceding its symbol offset.",
      block: {
        mov rcx, rdi;
        and rcx, 0x8000000000000000;
        cmp rcx, 0;
        ret
      }
    }
}
