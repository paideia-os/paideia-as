**/*.rs.bk
examples/*.o
examples/*.efi
examples/*.pax
examples/*.placeholder

# Diagnostic sidecars emitted by `paideia-as check`
**/*.pdx.sarif.json

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store

# Direnv
.envrc
.direnv/

# Nix
result
result-*

# Logs
*.log

