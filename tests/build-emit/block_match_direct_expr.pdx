// Issue #1208: baseline test for direct-expression match (no braces)
// Tests that a 3-arm enum match in direct tail position works correctly.
// This form should work even before #1208 fix.
// Expected exit code: 2

module BlockMatchDirectExpr = structure {
  enum State { Init, Running, Done }
  pub let entry : () -> u64 !{} @{} = fn(_: ()) -> {
    let s : State = State::Running
    match s {
      Init => 1u64
      Running => 2u64
      Done => 3u64
    }
  }
}
