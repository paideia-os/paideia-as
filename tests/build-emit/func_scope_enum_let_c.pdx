// Issue #1206: bare enum literal in function-scope let — unit variant C
// Tests that `let c : Choice = Choice::C` in function body emits code correctly
// Expected exit code: 3

module FuncScopeEnumLetC = structure {
  enum Choice { A, B, C }
  pub let entry : () -> u64 !{} @{} = fn(_: ()) -> {
    let c : Choice = Choice::C
    match c {
      A => 1u64
      B => 2u64
      C => 3u64
    }
  }
}
