// Phase 4 m11-001 (v0.18 #997): Option<T> fixture — unwrap_or on None.
//
// Demonstrates unwrap_or behavior on None variant.
// Uses concrete OptionU64 monomorphization and free-function unwrap_or pending #997c.

module OptionUnwrapOrNone = structure {
  enum OptionU64 { Some(u64), None }
  pub let option_u64_unwrap_or : (OptionU64, u64) -> u64 !{} @{} =
    fn(opt : OptionU64, default : u64) -> match opt {
      Some(x) => x,
      _       => default,
    }
  pub let x : u64 = option_u64_unwrap_or(OptionU64::None, 99u64)
}
