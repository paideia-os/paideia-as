//! #1196: flat-lambda BinOp canary: (Var, Literal) right-shift
//! Pattern: fn (v) -> v >> 2
//! Before #1196: silently miscompiled as v << 2
//! After #1196: correctly emits SHR instruction via shared lowerer

module FlatLambdaBinopShrVarLit = structure {
  let compute : (u64) -> u64 =
    fn (v: u64) -> v >> 2

  pub let entry : () -> u64 =
    fn () -> compute(12)
}
