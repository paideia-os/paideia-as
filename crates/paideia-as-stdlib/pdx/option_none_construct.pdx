// Phase 4 m11-001 (v0.18 #997): Option<T> fixture — None construction.
//
// Demonstrates enum-variant construction for Option<T>.
// Uses concrete OptionU64 monomorphization pending #997c.

module OptionNoneConstruct = structure {
  enum OptionU64 { Some(u64), None }
  pub let x : OptionU64 = OptionU64::None
}
