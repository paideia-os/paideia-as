// Phase 4 m11-001 (v0.18 #997): Result<T, E> fixture — match Ok extract.
//
// Demonstrates pattern matching to extract value from Ok variant.

module ResultMatchOkExtract = structure {
  enum ResultU64U64 { Ok(u64), Err(u64) }
  pub let entry : () -> u64 !{} @{} = fn(_: ()) -> {
    let x : ResultU64U64 = ResultU64U64::Ok(42u64)
    match x {
      Ok(n)  => n,
      Err(_) => 0u64,
    }
  }
}
