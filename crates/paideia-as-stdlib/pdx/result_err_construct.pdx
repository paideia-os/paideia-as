// Phase 4 m11-001 (v0.18 #997): Result<T, E> fixture — Err construction.
//
// Demonstrates enum-variant construction for Result<T, E>.
// Uses concrete ResultU64U64 monomorphization pending #997c.

module ResultErrConstruct = structure {
  enum ResultU64U64 { Ok(u64), Err(u64) }
  pub let x : ResultU64U64 = ResultU64U64::Err(7u64)
}
