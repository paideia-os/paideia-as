              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Phase 8 m1-004: during binary emission (ELF or PE), the encoder encountered an error while processing an IR node. This typically indicates an encoder bug or an unsupported IR shape. The error message details the specific failure. Report this issue with the code that triggered it."
              },
