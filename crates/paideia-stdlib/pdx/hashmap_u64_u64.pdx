// v0.18 issue #996 (pa-r18-003): HashMapU64U64 — canonical fixed-capacity implementation.
//
// Struct-of-arrays layout in .bss: 32-slot capacity, open-addressing linear probing.
// Hash → index: Fibonacci multiplier 0x9E3779B97F4A7C15, fold via shr 59 into 5-bit index.
// State column: 0 = empty, 1 = occupied, 2 = tombstone (reserved for #996d).
// Effect row: !{} on all operations (no rehash path until #996e).
// Return convention: get() returns OptionU64 via #997 pair ABI (RAX = discriminant, RDX = payload).

module HashMapU64U64 = structure {
  // Struct-of-arrays buffers (32 slots × 3 words + 1 length word = 97 words = 776 B).
  pub let mut hm_state  : [u64; 32] = uninit
  pub let mut hm_keys   : [u64; 32] = uninit
  pub let mut hm_values : [u64; 32] = uninit
  pub let mut hm_len    : u64       = 0

  enum OptionU64 { Some(u64), None }

  // Helper: Fibonacci hash (k ⊕ (k >> 33)) × 0x9E3779B97F4A7C15 >> 59 → 5-bit index.
  // Returns index in rax (0..31); does not modify other registers.
  let fibhash : (u64) -> u64 !{} @{} = fn(k: u64) -> unsafe {
    effects: {},
    capabilities: {},
    justification: "Fibonacci hash fold into 5-bit index",
    block: {
      // rdi = k (first param)
      // Compute h = k ⊕ (k >> 33)
      mov rax, rdi
      shr rax, 33
      xor rax, rdi
      // h now in rax; multiply by golden ratio prime.
      // 0x9E3779B97F4A7C15 does NOT fit imm32, so pre-load into r11.
      mov r11, 0x9E3779B97F4A7C15
      imul rax, r11
      // Fold into 5-bit index via shr 59.
      shr rax, 59
    }
  }

  // hashmap_u64_new() — zero all state, reset len.
  pub let hashmap_u64_new : () -> () !{} @{} = fn(_: ()) -> unsafe {
    effects: {},
    capabilities: {},
    justification: "HashMapU64U64 initialization",
    block: {
      // Loop: i = 0..32, zero hm_state[i], hm_keys[i], hm_values[i].
      // Use r8as loop counter, r15 as base address.
      lea r15, [rip + hm_state]
      xor r8, r8

      new_loop:
      cmp r8, 32
      jz new_done

      // Zero state, keys, values at index i.
      mov [r15 + rsi*8], 0
      lea r14, [rip + hm_keys]
      mov [r14 + rsi*8], 0
      lea r14, [rip + hm_values]
      mov [r14 + rsi*8], 0

      inc rsi
      jmp new_loop

      new_done:
      // Zero hm_len.
      lea r15, [rip + hm_len]
      mov [r15], 0
    }
  }

  // hashmap_u64_put(k: u64, v: u64) -> u64 !{} @{}
  // Returns 1 on success (insert or replace), 0 if table is full.
  // Linear probe from hash(k) until empty slot found or key match.
  pub let hashmap_u64_put : (u64, u64) -> u64 !{} @{} = fn(k: u64, v: u64) -> unsafe {
    effects: {},
    capabilities: {},
    justification: "HashMapU64U64 put with linear probing",
    block: {
      // rdi = k, r8= v. Use r12 for loop index, r13 for hash displacement.
      // Call fibhash(k) → rax = index.
      push rsi
      push rdi
      call fibhash
      pop rdi
      pop rsi

      mov r12, rax
      xor r13, r13

      put_probe_loop:
      // Compute probe index: (hash + displacement) & 0x1f.
      mov r14, r12
      add r14, r13
      and r14, 0x1f

      // Load state[probe_index] via lea + mov.
      lea r15, [rip + hm_state]
      mov r8, [r15 + r14*8]

      // If empty (state == 0), insert.
      cmp r8, 0
      je put_insert

      // If occupied (state == 1), check key match.
      cmp r8, 1
      jne put_probe_next

      // Key match check.
      lea r15, [rip + hm_keys]
      mov r8, [r15 + r14*8]
      cmp r8, rdi
      je put_replace

      put_probe_next:
      inc r13
      cmp r13, 32
      jl put_probe_loop

      // Table full.
      mov rax, 0
      jmp put_done

      put_insert:
      // Insert new key-value pair.
      lea r15, [rip + hm_state]
      mov [r15 + r14*8], 1
      lea r15, [rip + hm_keys]
      mov [r15 + r14*8], rdi
      lea r15, [rip + hm_values]
      mov [r15 + r14*8], rsi

      // Increment len.
      lea r15, [rip + hm_len]
      mov r8, [r15]
      inc r8
      mov [r15], r8

      mov rax, 1
      jmp put_done

      put_replace:
      // Replace existing value.
      lea r15, [rip + hm_values]
      mov [r15 + r14*8], rsi
      mov rax, 1

      put_done:
    }
  }

  // hashmap_u64_get(k: u64) -> OptionU64 !{} @{}
  // Returns Some(v) or None. Per #997 pair ABI: rax = discriminant, rdx = value.
  pub let hashmap_u64_get : (u64) -> OptionU64 !{} @{} = fn(k: u64) -> unsafe {
    effects: {},
    capabilities: {},
    justification: "HashMapU64U64 get with linear probing",
    block: {
      // rdi = k. Use r12 for probe index, r13 for displacement.
      push rdi
      call fibhash
      pop rdi

      mov r12, rax
      xor r13, r13

      get_probe_loop:
      // Compute probe index: (hash + displacement) & 0x1f.
      mov r14, r12
      add r14, r13
      and r14, 0x1f

      // Load state[probe_index].
      lea r15, [rip + hm_state]
      mov r8, [r15 + r14*8]

      // If empty, return None.
      cmp r8, 0
      je get_not_found

      // If occupied, check key.
      cmp r8, 1
      jne get_probe_next

      lea r15, [rip + hm_keys]
      mov r8, [r15 + r14*8]
      cmp r8, rdi
      je get_found

      get_probe_next:
      inc r13
      cmp r13, 32
      jl get_probe_loop

      get_not_found:
      // Return None: rax = 0 (discriminant), rdx = 0 (unused).
      xor rax, rax
      xor rdx, rdx
      jmp get_done

      get_found:
      // Return Some(v): rax = 1 (discriminant), rdx = value.
      lea r15, [rip + hm_values]
      mov rdx, [r15 + r14*8]
      mov rax, 1

      get_done:
    }
  }

  // hashmap_u64_contains(k: u64) -> u64 !{} @{}
  // Returns 1 if key present, 0 otherwise. Downgraded to u64 until #1229 bool-return verified.
  pub let hashmap_u64_contains : (u64) -> u64 !{} @{} = fn(k: u64) -> unsafe {
    effects: {},
    capabilities: {},
    justification: "HashMapU64U64 contains check",
    block: {
      // rdi = k. Reuse get probe logic but return 1/0.
      push rdi
      call fibhash
      pop rdi

      mov r12, rax
      xor r13, r13

      contains_probe_loop:
      // Compute probe index: (hash + displacement) & 0x1f.
      mov r14, r12
      add r14, r13
      and r14, 0x1f

      // Load state[probe_index].
      lea r15, [rip + hm_state]
      mov r8, [r15 + r14*8]

      // If empty, return 0.
      cmp r8, 0
      je contains_not_found

      // If occupied, check key.
      cmp r8, 1
      jne contains_probe_next

      lea r15, [rip + hm_keys]
      mov r8, [r15 + r14*8]
      cmp r8, rdi
      je contains_found

      contains_probe_next:
      inc r13
      cmp r13, 32
      jl contains_probe_loop

      contains_not_found:
      xor rax, rax
      jmp contains_done

      contains_found:
      mov rax, 1

      contains_done:
    }
  }

  // hashmap_u64_len() -> u64 !{} @{}
  // Returns current number of live entries.
  pub let hashmap_u64_len : () -> u64 !{} @{} = fn(_: ()) -> unsafe {
    effects: {},
    capabilities: {},
    justification: "HashMapU64U64 length query",
    block: {
      lea r15, [rip + hm_len]
      mov rax, [r15]
    }
  }
}
