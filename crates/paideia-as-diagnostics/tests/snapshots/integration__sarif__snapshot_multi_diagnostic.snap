              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "During arm-body lowering, the elaborator attempted to lower a Var operand\nbut found that the variable's binding name is not present in the current\nlocal_bindings map. This indicates that the variable was not bound in the\nmatch arm's scope, or the binding was lost before operand lowering occurred.\n\nIssue #1147 slice A5b migration from the legacy Vec<String> diagnostic channel\nto the typed pipe.\n"
              },
              "helpUri": "https://paideia-os.org/diagnostics/U1657",
              "id": "U1657",
              "name": "App node var not in local_bindings",
              "shortDescription": {
