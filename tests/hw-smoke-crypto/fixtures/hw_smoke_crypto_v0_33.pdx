  pub let RFC_8439_SEC_2_8_2_SEALED : [u8; 130] = [
    0xd3, 0x1a, 0x8d, 0x34, 0x64, 0x8e, 0x60, 0xdb, 0x7b, 0x86, 0xaf, 0xbc, 0x53, 0xef, 0x7e, 0xc2,
    0xa4, 0xad, 0xed, 0x51, 0x29, 0x6e, 0x08, 0xfe, 0xa9, 0xe2, 0xb5, 0xa7, 0x36, 0xee, 0x62, 0xd6,
    0x3d, 0xbe, 0xa4, 0x5e, 0x8c, 0xa9, 0x67, 0x12, 0x82, 0xfa, 0xfb, 0x69, 0xda, 0x92, 0x72, 0x8b,
    0x1a, 0x71, 0xde, 0x0a, 0x9e, 0x06, 0x0b, 0x29, 0x05, 0xd6, 0xa5, 0xb6, 0x7e, 0xcd, 0x3b, 0x36,
    0x92, 0xdd, 0xbd, 0x7f, 0x2d, 0x77, 0x8b, 0x8c, 0x98, 0x03, 0xae, 0xe3, 0x28, 0x09, 0x1b, 0x58,
    0xfa, 0xb3, 0x24, 0xe4, 0xfa, 0xd6, 0x75, 0x94, 0x55, 0x85, 0x80, 0x8b, 0x48, 0x31, 0xd7, 0xbc,
    0x3f, 0xf4, 0xde, 0xf0, 0x8e, 0x4b, 0x7a, 0x9d, 0xe5, 0x76, 0xd2, 0x65, 0x86, 0xce, 0xc6, 0x4b,
    0x61, 0x16, 0x1a, 0xe1, 0x0b, 0x59, 0x4f, 0x09, 0xe2, 0x6a, 0x7e, 0x90, 0x2e, 0xcb, 0xd0, 0x60,
    0x06, 0x91,
  ]  // ciphertext || tag (130 bytes)
  // AeadParamsC blob -- field order matches
  // crates/paideia-as-crypto/src/ffi/chacha20_poly1305.rs::AeadParamsC:
  //   [key_ptr, nonce_ptr, aad_ptr, aad_len]
  // Reused for both seal() and open(): same RFC vector round-trips the
  // same (key, nonce, aad) through both directions.
  let chacha_aead_params : [u64; 4] = [
    &RFC_8439_SEC_2_8_2_KEY, &RFC_8439_SEC_2_8_2_NONCE, &RFC_8439_SEC_2_8_2_AAD, 12
  ]

  let mut chacha_seal_out : [u8; 130] = [0; 130]
  let mut chacha_seal_written : u64 = 0
  let mut chacha_open_out : [u8; 114] = [0; 114]
  let mut chacha_open_written : u64 = 0

  // -------------------------------------------------------------
  // ML-KEM-768 -- FIPS 203 / NIST ACVP-Server commit 65370b8
  // -------------------------------------------------------------
  //
  // Three independent vectors (KeyGen tc26, Encaps tc26, Decaps tc88 --
  // the first "no modification" decaps entry, so K is the genuine
  // shared secret rather than the implicit-rejection fallback). No
  // params struct: the FFI thunks take raw fixed-size buffer pointers
  // directly (see crates/paideia-as-crypto/src/ffi/ml_kem_768.rs).

  pub let ACVP_KG_D : [u8; 32] = [
    0xe3, 0x4a, 0x70, 0x1c, 0x4c, 0x87, 0x58, 0x2f, 0x42, 0x26, 0x4e, 0xe4, 0x22, 0xd3, 0xc6, 0x84,
    0xd9, 0x76, 0x11, 0xf2, 0x52, 0x3e, 0xfe, 0x0c, 0x99, 0x8a, 0xf0, 0x50, 0x56, 0xd6, 0x93, 0xdc,
  ]

  pub let ACVP_KG_Z : [u8; 32] = [
