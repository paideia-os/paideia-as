crates/paideia-as/tests/data/*.placeholder
tests/linearity-regression/accept/*.placeholder
tests/linearity-regression/reject/*.placeholder
tests/reflection-corpus/corpus/accept/*.placeholder
tests/reflection-corpus/corpus/reject/*.placeholder
tests/effects-corpus/corpus/accept/*.placeholder
tests/effects-corpus/corpus/reject/*.placeholder
