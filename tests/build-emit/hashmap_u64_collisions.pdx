// v0.18 issue #996 (pa-r18-003): Runtime canary driver — HashMapU64U64 collision resolution.
// Expected exit code: 100 (sum of 4 × 25)
//
// Four keys designed to hash to slot 0, testing linear-probing collision handling.
// Keys: 0, 0x9000000000000000, 0xA000000000000000, 0xB000000000000000
// (these should hash to slot 0; if test fails, verify hash locally and adjust)

module HashmapU64Collisions = structure {
  pub let mut hm_state  : [u64; 32] = uninit
  pub let mut hm_keys   : [u64; 32] = uninit
  pub let mut hm_values : [u64; 32] = uninit
  pub let mut hm_len    : u64       = 0

  enum OptionU64 { Some(u64), None }

  let fibhash : (u64) -> u64 !{} @{} = fn(k: u64) -> unsafe {
    effects: {},
    capabilities: {},
    justification: "Fibonacci hash fold into 5-bit index",
    block: {
      mov rax, rdi
      shr rax, 33
      xor rax, rdi
      mov r11, 0x9E3779B97F4A7C15
      imul rax, r11
      shr rax, 59
      ret
    }
  }

  let hashmap_u64_put : (u64, u64) -> u64 !{} @{} = fn(k: u64, v: u64) -> unsafe {
    effects: {},
    capabilities: {},
    justification: "HashMapU64U64 put with linear probing",
    block: {
      push rsi
      push rdi
      call fibhash
      pop rdi
      pop rsi

      mov r12, rax
      xor r13, r13

      put_probe_loop:
      mov r14, r12
      add r14, r13
      and r14, 0x1f

      lea r15, [rip + hm_state]
      mov r8, [r15 + r14*8]

      cmp r8, 0
      je put_insert

      cmp r8, 1
      jne put_probe_next

      lea r15, [rip + hm_keys]
      mov r8, [r15 + r14*8]
      cmp r8, rdi
      je put_replace

      put_probe_next:
      inc r13
      cmp r13, 32
      jl put_probe_loop

      mov rax, 0
      jmp put_done

      put_insert:
      lea r15, [rip + hm_state]
      mov [r15 + r14*8], 1
      lea r15, [rip + hm_keys]
      mov [r15 + r14*8], rdi
      lea r15, [rip + hm_values]
      mov [r15 + r14*8], rsi

      lea r15, [rip + hm_len]
      mov r8, [r15]
      inc r8
      mov [r15], r8

      mov rax, 1
      jmp put_done

      put_replace:
      lea r15, [rip + hm_values]
      mov [r15 + r14*8], rsi
      mov rax, 1

      put_done:
      ret
    }
  }

  let hashmap_u64_get : (u64) -> OptionU64 !{} @{} = fn(k: u64) -> unsafe {
    effects: {},
    capabilities: {},
    justification: "HashMapU64U64 get with linear probing",
    block: {
      push rdi
      call fibhash
      pop rdi

      mov r12, rax
      xor r13, r13

      get_probe_loop:
      mov r14, r12
      add r14, r13
      and r14, 0x1f

      lea r15, [rip + hm_state]
      mov r8, [r15 + r14*8]

      cmp r8, 0
      je get_not_found

      cmp r8, 1
      jne get_probe_next

      lea r15, [rip + hm_keys]
      mov r8, [r15 + r14*8]
      cmp r8, rdi
      je get_found

      get_probe_next:
      inc r13
      cmp r13, 32
      jl get_probe_loop

      get_not_found:
      // OptionU64 { Some(u64), None } — declaration order gives Some
      // discriminant 0, None discriminant 1. Not-found -> None -> rax=1.
      mov rax, 1
      xor rdx, rdx
      jmp get_done

      get_found:
      // Found -> Some(v) -> rax=0 (discriminant), rdx=v (payload).
      lea r15, [rip + hm_values]
      mov rdx, [r15 + r14*8]
      xor rax, rax

      get_done:
      ret
    }
  }

  // Note: summing 4 OptionU64-returning `hashmap_u64_get` calls hits two
  // current elaborator limits if done via safe-mode `let` + `match`:
  //   - match scrutinees must be a bound Var (no direct call-as-scrutinee),
  //     which needs one `let` per get to hold the OptionU64 result;
  //   - the function-body budget allows at most 4 in-flight let-literal
  //     bindings (T0527), and chaining `match {...} + match {...}` puts a
  //     match expression in non-tail position, which the parser rejects.
  // Both keys are known-present by construction (just inserted), so the
  // sum is computed directly in raw asm instead: call hashmap_u64_get 4x
  // and accumulate the payload (rdx) in rbx, which put/get/fibhash never
  // touch internally.
  //
  // Also note: a call-expression *statement* (e.g. `hashmap_u64_put(0, 25)`)
  // mixed into an unsafe block is deferred to a separate emission pass and
  // ends up emitted *after* all raw asm in the block, even after this
  // block's own `ret` (see #1244: unsafe-block StmtExpr call statements do
  // not preserve source order relative to raw instructions). So every call
  // here, including the puts, is issued via raw `call` with manual argument
  // register loads to keep everything in one ordered instruction stream.
  // (Match-scrutinee-must-be-Var diagnostic-quality gap tracked as #1243.)
  pub let entry : () -> u64 !{} @{} = fn(_: ()) -> unsafe {
    effects: {},
    capabilities: {},
    justification: "Insert 4 colliding keys, then sum retrieved values via direct calls",
    block: {
      push rbx
      xor rbx, rbx

      // Insert 4 keys with value 25 each (should collide at slot 0).
      mov rdi, 0
      mov rsi, 25
      call hashmap_u64_put

      mov rdi, 0x9000000000000000
      mov rsi, 25
      call hashmap_u64_put

      mov rdi, 0xA000000000000000
      mov rsi, 25
      call hashmap_u64_put

      mov rdi, 0xB000000000000000
      mov rsi, 25
      call hashmap_u64_put

      mov rdi, 0
      call hashmap_u64_get
      add rbx, rdx

      mov rdi, 0x9000000000000000
      call hashmap_u64_get
      add rbx, rdx

      mov rdi, 0xA000000000000000
      call hashmap_u64_get
      add rbx, rdx

      mov rdi, 0xB000000000000000
      call hashmap_u64_get
      add rbx, rdx

      mov rax, rbx
      pop rbx
      ret
    }
  }
}
