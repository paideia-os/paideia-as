// v0.18 #998: Modified stub — str_split_yields.
//
// Verify that str_split iterates over substrings separated by a delimiter byte.
// Phase-4-m11-003 minimum: parse-only. Updated to align on Str { ptr: *u8, len: u64 } (v0.18 #998).
// Implementation blocked on #998c (iterator protocol).

struct Str {
  ptr: *u8,
  len: u64,
}

trait StrSplit {
  fn str_split(s: Str, sep: u8) -> Iterator<Str>;
}
