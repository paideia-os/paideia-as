// Phase 4 m11-001 (v0.18 #997): Option<T> sum type + methods.
//
// Option<T> represents an optional value. Every Option<T> is either
// Some(value) or None.
//
// Generic enum declaration:
enum Option<T> {
  Some(T),
  None,
}

