// Issue #1210: Integer-scrutinee match with 3 arms, literal scrutinee 1u64
// Tests integer match with multiple arm cascade.
// Expected exit code: 20

module IntmatchLitThree = structure {
  pub let entry : () -> u64 !{} @{} = fn(_: ()) ->
    match 1u64 {
      0u64 => 10u64
      1u64 => 20u64
      _ => 30u64
    }
}
