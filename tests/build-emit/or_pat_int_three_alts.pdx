// Issue #1001: or_pat_int_three_alts
// Tests or-pattern matching with multiple alternatives across arms
// Expected exit code: 40

module OrPatIntThreeAlts = structure {
  pub let entry : () -> u64 !{} @{} = fn(_ : ()) -> {
    match 3u64 {
      0u64 | 1u64 | 2u64 => 1u64
      3u64 | 4u64 => 40u64
      _ => 0u64
    }
  }
}
