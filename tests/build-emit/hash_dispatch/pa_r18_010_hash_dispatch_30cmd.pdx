// v0.18 issue #1003 (pa-r18-010): hash-based command dispatch — 30-command scaffold.
// Expected exit code: 14
//
// This fixture demonstrates that hash-based command dispatch scales beyond
// the density-contract threshold for @jump_table fallback. 30 command handlers
// are registered in the hash table, and we dispatch on cmd14 (which should
// return 14).
//
// To avoid too many collisions, this fixture uses [u64; 64] storage with
// 6-bit masking instead of [u64; 32] with 5-bit masking.

module PaR18HashDispatch30cmd = structure {
  pub let mut hm_state  : [u64; 64] = uninit
  pub let mut hm_keys   : [u64; 64] = uninit
  pub let mut hm_values : [u64; 64] = uninit
  pub let mut hm_len    : u64       = 0

  enum OptionU64 { Some(u64), None }

  let fibhash : (u64) -> u64 !{} @{} = fn(k: u64) -> unsafe {
    effects: {},
    capabilities: {},
    justification: "Fibonacci hash fold into 6-bit index",
    block: {
      mov rax, rdi
      shr rax, 33
      xor rax, rdi
      mov r11, 0x9E3779B97F4A7C15
      imul rax, r11
      shr rax, 58
      ret
    }
  }

  let hashmap_u64_put : (u64, u64) -> u64 !{} @{} = fn(k: u64, v: u64) -> unsafe {
    effects: {},
    capabilities: {},
    justification: "HashMapU64U64 put with linear probing (6-bit)",
    block: {
      push rsi
      push rdi
      call fibhash
      pop rdi
      pop rsi

      mov r12, rax
      xor r13, r13

      put_probe_loop:
      mov r14, r12
      add r14, r13
      and r14, 0x3f

      lea r15, [rip + hm_state]
      mov r8, [r15 + r14*8]

      cmp r8, 0
      je put_insert

      cmp r8, 1
      jne put_probe_next

      lea r15, [rip + hm_keys]
      mov r8, [r15 + r14*8]
      cmp r8, rdi
      je put_replace

      put_probe_next:
      inc r13
      cmp r13, 64
      jl put_probe_loop

      mov rax, 0
      jmp put_done

      put_insert:
      lea r15, [rip + hm_state]
      mov [r15 + r14*8], 1
      lea r15, [rip + hm_keys]
      mov [r15 + r14*8], rdi
      lea r15, [rip + hm_values]
      mov [r15 + r14*8], rsi

      lea r15, [rip + hm_len]
      mov r8, [r15]
      inc r8
      mov [r15], r8

      mov rax, 1
      jmp put_done

      put_replace:
      lea r15, [rip + hm_values]
      mov [r15 + r14*8], rsi
      mov rax, 1

      put_done:
      ret
    }
  }

  let hashmap_u64_get : (u64) -> OptionU64 !{} @{} = fn(k: u64) -> unsafe {
    effects: {},
    capabilities: {},
    justification: "HashMapU64U64 get with linear probing (6-bit)",
    block: {
      push rdi
      call fibhash
      pop rdi

      mov r12, rax
      xor r13, r13

      get_probe_loop:
      mov r14, r12
      add r14, r13
      and r14, 0x3f

      lea r15, [rip + hm_state]
      mov r8, [r15 + r14*8]

      cmp r8, 0
      je get_not_found

      cmp r8, 1
      jne get_probe_next

      lea r15, [rip + hm_keys]
      mov r8, [r15 + r14*8]
      cmp r8, rdi
      je get_found

      get_probe_next:
      inc r13
      cmp r13, 64
      jl get_probe_loop

      get_not_found:
      mov rax, 1
      xor rdx, rdx
      jmp get_done

      get_found:
      lea r15, [rip + hm_values]
      mov rdx, [r15 + r14*8]
      xor rax, rax

      get_done:
      ret
    }
  }


  let handle_cmd0 : () -> u64 !{} @{} = fn(_: ()) -> unsafe {
    effects: {},
    capabilities: {},
    justification: "cmd0 command handler",
    block: {
      mov rax, 0
      ret
    }
  }

  let handle_cmd1 : () -> u64 !{} @{} = fn(_: ()) -> unsafe {
    effects: {},
    capabilities: {},
    justification: "cmd1 command handler",
