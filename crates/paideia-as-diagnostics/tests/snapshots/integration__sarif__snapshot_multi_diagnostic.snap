            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "During field-access elaboration (read or write), the elaborator attempted to\nlook up the record layout for a field's type_id but the layout was not found\nin the record_layouts table. This indicates that a record type was not\nproperly registered during elaboration, or the type_id is invalid.\n\nIssue #1147 slice A4 migration from the legacy Vec<String> diagnostic channel\nto the typed pipe. This diagnostic indicates a compiler-internal invariant\nviolation and should not occur in normal compilation.\n"
              },
              "helpUri": "https://paideia-os.org/diagnostics/U1645",
              "id": "U1645",
              "name": "Record layout missing for elaborated field type (invariant violation)",
              "shortDescription": {
