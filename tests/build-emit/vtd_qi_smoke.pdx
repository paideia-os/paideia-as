// paideia-as #1318 (R51-paideia-as-004): VT-d QI invalidation smoke coverage.
//
// This fixture is a compile-time descriptor bank exercising the assembler's
// ability to emit byte-exact 128-bit VT-d Queued Invalidation (QI)
// descriptors for every architected QI descriptor type. Preventive coverage:
// R51 makes the R35 vtd_ctx.pdx QI-invalidate wire a regular caller, so
// any latent gap in u64 array packing under a large descriptor bank would
// surface as a hardware drop under 10 kHz submission. Verifying byte-exact
// .rodata layout here catches that at build time.
//
// Layout (Intel VT-d Architecture Spec §6.5.2):
//   Each descriptor is 16 bytes = two little-endian u64s (QW0, QW1).
//   16 descriptors × 16 B = 256 B of .rodata, covering all 8 QI types
//   with two parameter variants per type.
//
// Type field lives in QW0 bits[3:0]:
//   1 = cc_inv     (Context Cache Invalidate)
//   2 = iotlb_inv  (IOTLB Invalidate)
//   3 = dev_iotlb  (Device-IOTLB Invalidate)
//   4 = iec_inv    (Interrupt Entry Cache Invalidate)
//   5 = inv_wait   (Invalidation Wait)
//   6 = p_iotlb    (PASID-based IOTLB Invalidate)
//   7 = p_cache    (PASID Cache Invalidate)
//   8 = p_dev_iotlb (PASID-based Device-IOTLB Invalidate)
//
// Every QW0/QW1 pair below is the exact bit-packed value a kernel driver
// would submit. The companion test walks the .rodata bytes and asserts
// both the little-endian encoding and the parsed VT-d field values.

module VtdQiSmoke = structure {
  // 16 descriptors × 2 u64 = 32 u64 = 256 bytes.
  //
  //   [0..1]   cc_inv (global-invalidate)              type=1 gran=1
  //   [2..3]   cc_inv (domain-selective)               type=1 gran=2, DID=0x100, SID=0xABCD, FM=2
  //   [4..5]   iotlb_inv (global)                      type=2 gran=1
  //   [6..7]   iotlb_inv (page-selective, DR|DW)       type=2 gran=3, DID=0x10, DR=1, DW=1, addr=0x1000
  //   [8..9]   dev_iotlb_inv (basic)                   type=3, SID=0x0100, addr=0x1000
  //   [10..11] dev_iotlb_inv (MIP, size=1)             type=3, SID=0xABCD, MIP=2, addr=0x2000, S=1
  //   [12..13] iec_inv (global)                        type=4 gran=0
  //   [14..15] iec_inv (index-selective)               type=4 gran=1, IIDX=0x100, IM=2
  //   [16..17] inv_wait (IF|FN, no status)             type=5 IF=1 FN=1
  //   [18..19] inv_wait (SW|FN, status write)          type=5 SW=1 FN=1, STDATA=0xDEADBEEF, STADDR=0xF0000000
  //   [20..21] p_iotlb (all-PASID)                     type=6 gran=1, DID=0x10, PASID=0x123
  //   [22..23] p_iotlb (page-selective within PASID)   type=6 gran=2, DID=0x20, PASID=0x456, addr=0x3000
  //   [24..25] p_cache (all-PASID)                     type=7 gran=1
  //   [26..27] p_cache (PASID-selective)               type=7 gran=2, DID=0x20, PASID=0x789
  //   [28..29] p_dev_iotlb (basic)                     type=8, PASID=0x100, SID=0x0100, addr=0x4000
  //   [30..31] p_dev_iotlb (MIP, size=1)               type=8, PASID=0x200, SID=0xABCD, MIP=1, addr=0x5000, S=1
  pub let qi_descriptors : [u64; 32] = [
    0x0000000000000011u64, 0x0000000000000000u64,
    0x0002ABCD01000021u64, 0x0000000000000000u64,
    0x0000000000000012u64, 0x0000000000000000u64,
    0x00000000001000F2u64, 0x0000000000001000u64,
    0x0000010000000003u64, 0x0000000000001000u64,
    0x0000ABCD00020003u64, 0x0000000000002001u64,
    0x0000000000000004u64, 0x0000000000000000u64,
    0x0000010010000014u64, 0x0000000000000000u64,
    0x0000000000000055u64, 0x0000000000000000u64,
    0xDEADBEEF00000065u64, 0x00000000F0000000u64,
    0x0000012300100016u64, 0x0000000000000000u64,
    0x0000045600200026u64, 0x0000000000003000u64,
    0x0000000000000017u64, 0x0000000000000000u64,
    0x0000078900200027u64, 0x0000000000000000u64,
    0x0000010001000008u64, 0x0000000000004000u64,
    0x0001ABCD02000008u64, 0x0000000000005001u64,
  ];
}
