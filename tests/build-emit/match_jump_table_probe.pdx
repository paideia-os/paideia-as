// Issue #1097: Dense enum + match dispatch — byte-order verification.
// Verifies dispatch (cmp/ja/jmp) emits BEFORE lambda RET (not dead code past ret).

module MatchJumpTableProbe = structure {
  enum Traffic { Red, Yellow, Green, Blue }
  pub let signal : Traffic = Traffic::Green
  pub let dispatch : () -> u64 !{} @{} = fn(_: ()) -> match signal {
    Red => 1u64
    Yellow => 2u64
    Green => 3u64
    Blue => 4u64
  }
}
