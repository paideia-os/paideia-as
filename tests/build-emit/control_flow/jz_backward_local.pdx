// Regression test for issue #901: jz with backward local label should compute correct disp32
// not write disp32 = 0.

module JzBackwardLocal = structure {
  // PAS-DEBT-B1-009 (#1491): body performs port I/O (in_al) so the
  // lambda type must declare !{PortIo} @{paideia.port_io} to satisfy
  // C1301 (effect_cap_coupling::check_fn_shape). See boot_observable.pdx
  // for the golden pattern; inner unsafe {effects, capabilities} stay
  // empty (tracked structurally, not lifted).
  let poll : () -> () !{PortIo} @{paideia.port_io} = fn(_: ()) -> unsafe {
    effects: {},
    capabilities: {},
    justification: "backward jz to local label (regression for #901)",
    block: {
label0:
      in_al al;
      and rax, 0x20;
      jz label0
    }
  }
}
