// Two straight-line calls, no loop.
// while-loop-around-call coverage retired 2026-07-08 in #1077; StmtWhile inside unsafe now fires U1614 (see #1088).
module CallInWhile = structure {
  let tgt_a : () -> () !{} @{} = fn(_: ()) -> unsafe {
    effects: {},
    capabilities: {},
    justification: "target a",
    block: { ret }
  }

  let tgt_b : () -> () !{} @{} = fn(_: ()) -> unsafe {
    effects: {},
    capabilities: {},
    justification: "target b",
    block: { ret }
  }

  let caller : () -> () !{} @{} = fn(_: ()) -> unsafe {
    effects: {},
    capabilities: {},
    justification: "calling with two sequential calls",
    block: { call tgt_a; call tgt_b; ret }
  }
}
