// PA-R16-010: Atomic bitmap primitives for paideia-os phys_alloc.
//
// Trait BitmapOps declares seven primitives for word-aligned bitmaps,
// supporting both non-atomic inspection and atomic RMW operations.
// Lowering deferred to elaborator #1036:
//   bitmap_get(bmap, bit_index)          -> bt [rdi], rsi              (from #967)
//   bitmap_set(bmap, bit_index)          -> lock bts [rdi], rsi        (from #968)
//   bitmap_clear(bmap, bit_index)        -> lock btr [rdi], rsi        (new)
//   bitmap_toggle(bmap, bit_index)       -> lock btc [rdi], rsi        (new)
//   bitmap_first_free(bmap, bit_capacity) -> per-word bsf scan        (from #974)
//   bitmap_word_count(bit_capacity)      -> (cap + 63) >> 6            (arithmetic)
//   bitmap_claim_first_free(bmap, bit_capacity) -> bitmap_first_free + lock bts retry loop (new)
//
// Semantics and boundary contracts:
//   - Bit indices: bit_index = 63 → word 0 bit 63; bit_index = 64 → word 1 bit 0
//   - Sentinel: u64::MAX (0xFFFFFFFFFFFFFFFF) signals "no free bit" or scan exhaustion
//   - bit_capacity = 0 → return sentinel (no bits available)
//   - bit_capacity not multiple of 64: high bits of last word are reserved; scan must not report free past capacity
//   - bitmap_claim_first_free: retries on race (word changed between scan and lock bts); on exhaustion returns sentinel
//
// Effect discipline:
//   - Non-atomic (bitmap_get, bitmap_word_count, bitmap_first_free): !{}
//   - Atomic RMW (bitmap_set, bitmap_clear, bitmap_toggle, bitmap_claim_first_free): !{Atomic}
//   - Capability: none (operates on caller-provided *u64; no privileged memory, no I/O port, no per-CPU override)

trait BitmapOps {
  fn bitmap_get(bmap: *u64, bit_index: u64) -> bool !{};
  fn bitmap_word_count(bit_capacity: u64) -> u64 !{};
  fn bitmap_set(bmap: *u64, bit_index: u64) -> bool !{Atomic};
  fn bitmap_clear(bmap: *u64, bit_index: u64) -> bool !{Atomic};
  fn bitmap_toggle(bmap: *u64, bit_index: u64) -> bool !{Atomic};
  fn bitmap_first_free(bmap: *u64, bit_capacity: u64) -> u64 !{};
  fn bitmap_claim_first_free(bmap: *u64, bit_capacity: u64) -> u64 !{Atomic};
}
