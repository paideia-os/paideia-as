//! #1193: flat-lambda BinOp canary: depth-2 nested shape
//! Pattern: fn (page, table_idx) -> (page | (table_idx << 12))
//! Routes through #1181 lowerer; depth-2 handling tests scratch pool allocation.

module FlatLambdaBinopDepth2 = structure {
  let compute : (u64, u64) -> u64 =
    fn (page: u64) (table_idx: u64) -> page | (table_idx << 12)

  pub let entry : () -> u64 =
    fn () -> compute(0x1000, 1)
}
