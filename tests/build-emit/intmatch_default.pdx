// Issue #1210: Integer-scrutinee match where default arm is hit
// Tests that default arm is correctly reached when scrutinee matches no patterns.
// Expected exit code: 99

module IntmatchDefault = structure {
  pub let entry : () -> u64 !{} @{} = fn(_: ()) ->
    match 42u64 {
      0u64 => 10u64
      1u64 => 20u64
      _ => 99u64
    }
}
