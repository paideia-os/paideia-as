// Issue #1204: multiple bare enum literals in module lets
// Tests that `let c1 = Choice::A; let c2 = Choice::B` both emit correct,
// independently-addressed symbols. c1 is defined first (and must still
// build with its own data symbol) but is never read; entry matches on
// c2, the SECOND module-let in program order, to prove that the second
// IrKind::Let rewrite in the same pass is not aliased/overwritten by
// the first and resolves to its own correct discriminant.
// c2=B => returns 2
// Expected exit code: 2

module UnitVarMultipleBindings = structure {
  enum Choice { A, B, C }
  pub let c1 : Choice = Choice::A
  pub let c2 : Choice = Choice::B
  pub let entry : () -> u64 !{} @{} = fn(_: ()) -> match c2 {
    A => 1u64
    B => 2u64
    C => 3u64
  }
}
