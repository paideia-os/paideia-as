module LevelErrorFail = structure {
  pub let boot : () -> () @{sysreg, mem} =
    fn () -> unsafe {
      effects: { sysreg, mem },
      capabilities: {},
      justification: "paideia-as#1274: *_fail_msg must emit LEVEL_ERROR=1, not LEVEL_TRACE=5 (which klog_emit_core's cmp rdi, KLOG_COMPILE_LEVEL=3; ja skip drops).",
      block: {
        lea rdi, [rip + gdt_ok_msg];
        call uart_puts;
        lea rdi, [rip + gdt_load_fail_msg];
        call uart_puts;
        lea rdi, [rip + tss_setup_fail_msg];
        call uart_puts;
        ret;
      }
    }
}
