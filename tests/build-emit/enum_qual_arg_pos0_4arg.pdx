// Issue #1202: Qualified-path enum variant at arg position 0 of 4-arg call
// Tests that Tag::A (unit variant) correctly marshalled to rdi in pick4(Tag::A, 7u64, 6u64, 1u64)
// Expected exit code: 42 (x * y = 7 * 6, z unused)

module EnumQualArgPos04arg = structure {
  enum Tag { A, B }

  pub let pick4 : (Tag, u64, u64, u64) -> u64 =
    fn (t: Tag) (x: u64) (y: u64) (z: u64) -> match t {
      A => x * y
      B => 0u64
    }

  pub let entry : () -> u64 =
    fn () -> pick4(Tag::A, 7u64, 6u64, 1u64)
}
