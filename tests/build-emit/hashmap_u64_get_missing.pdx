// v0.18 issue #996 (pa-r18-003): Runtime canary driver — HashMapU64U64::get on empty map returns None.
// Expected exit code: 0 (unwrap_or default 0)

module HashmapU64GetMissing = structure {
  pub let mut hm_state  : [u64; 32] = uninit
  pub let mut hm_keys   : [u64; 32] = uninit
  pub let mut hm_values : [u64; 32] = uninit
  pub let mut hm_len    : u64       = 0

  enum OptionU64 { Some(u64), None }

  let fibhash : (u64) -> u64 !{} @{} = fn(k: u64) -> unsafe {
    effects: {},
    capabilities: {},
    justification: "Fibonacci hash fold into 5-bit index",
    block: {
      mov rax, rdi
      shr rax, 33
      xor rax, rdi
      mov r11, 0x9E3779B97F4A7C15
      imul rax, r11
      shr rax, 59
    }
  }

  let hashmap_u64_get : (u64) -> OptionU64 !{} @{} = fn(k: u64) -> unsafe {
    effects: {},
    capabilities: {},
    justification: "HashMapU64U64 get with linear probing",
    block: {
      push rdi
      call fibhash
      pop rdi

      mov r12, rax
      xor r13, r13

      get_probe_loop:
      mov r14, r12
      add r14, r13
      and r14, 0x1f

      lea r15, [rip + hm_state]
      mov r8, [r15 + r14*8]

      cmp r8, 0
      je get_not_found

      cmp r8, 1
      jne get_probe_next

      lea r15, [rip + hm_keys]
      mov r8, [r15 + r14*8]
      cmp r8, rdi
      je get_found

      get_probe_next:
      inc r13
      cmp r13, 32
      jl get_probe_loop

      get_not_found:
      xor rax, rax
      xor rdx, rdx
      jmp get_done

      get_found:
      lea r15, [rip + hm_values]
      mov rdx, [r15 + r14*8]
      mov rax, 1

      get_done:
    }
  }

  pub let entry : () -> u64 !{} @{} = fn(_: ()) -> {
    let opt : OptionU64 = hashmap_u64_get(99)
    match opt {
      Some(v) => v,
      None    => 0,
    }
  }
}
