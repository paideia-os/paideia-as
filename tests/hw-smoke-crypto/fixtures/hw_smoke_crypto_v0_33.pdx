  // -------------------------------------------------------------
  // Orchestrator -- ordinary (non-unsafe) `_start`, exactly the shape
  // proven by tests/build-emit/pa_r17_unsafe_while_stmt.pdx's `_start`
  // (a safe function calling into unsafe leaves). All branching lives
  // here, outside every unsafe block.
  // -------------------------------------------------------------

  let _start : () -> () !{crypto, mem, RawMem, PortIo} @{paideia.crypto, paideia.raw_mem, paideia.port_io} = fn(_: ()) -> {
    let r1 : u64 = run_argon2id_probe();
    if r1 == 1 { emit_argon2id_ok() } else { emit_argon2id_fail() };
    let r2 : u64 = run_chacha_seal_probe();
    if r2 == 1 { emit_chacha_seal_ok() } else { emit_chacha_seal_fail() };
    let r3 : u64 = run_chacha_open_probe();
    if r3 == 1 { emit_chacha_open_ok() } else { emit_chacha_open_fail() };
    let r4 : u64 = run_kem_keygen_probe();
    if r4 == 1 { emit_kem_keygen_ok() } else { emit_kem_keygen_fail() };
    let r5 : u64 = run_kem_encaps_probe();
    if r5 == 1 { emit_kem_encaps_ok() } else { emit_kem_encaps_fail() };
    let r6 : u64 = run_kem_decaps_probe();
    if r6 == 1 { emit_kem_decaps_ok() } else { emit_kem_decaps_fail() };
    let total : u64 = r1 + r2 + r3 + r4 + r5 + r6;
    if total == 6 { emit_all_ok() } else { () };
    halt()
  }
}
