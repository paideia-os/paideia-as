  pub let ACVP_DE_K : [u8; 32] = [
    0xdc, 0x5b, 0x88, 0x88, 0xbc, 0x1e, 0xba, 0x5c, 0x19, 0x69, 0xc2, 0x11, 0x64, 0xea, 0x43, 0xe2,
    0x2e, 0x7a, 0xc0, 0xcd, 0x01, 0x2a, 0x2f, 0x26, 0xcb, 0x8c, 0x48, 0x7e, 0x69, 0xef, 0x7c, 0xe4,
  ]
  let mut kem_kg_ek : [u8; 1184] = [0; 1184]
  let mut kem_kg_dk : [u8; 2400] = [0; 2400]
  let mut kem_en_c : [u8; 1088] = [0; 1088]
  let mut kem_en_k : [u8; 32] = [0; 32]
  let mut kem_de_k : [u8; 32] = [0; 32]

  // -------------------------------------------------------------
  // Byte-compare helper -- ordinary (non-unsafe) function, so `while`
  // + `if` are fully available (tests/corpus/while_loop.pdx,
  // tests/build-emit/pa8_if_as_final_expr.pdx). Uses BytesOps::get_u8
  // rather than a hand-rolled memcmp so the comparison itself goes
  // through an already-wired stdlib recipe.
  // -------------------------------------------------------------

  let bytes_eq : (u64, u64, u64) -> u64 !{RawMem} @{paideia.raw_mem} = fn(a: u64, b: u64, n: u64) -> {
    let mut i : u64 = 0;
    let mut ok : u64 = 1;
    while i < n {
      if BytesOps::get_u8(a, i) != BytesOps::get_u8(b, i) {
        ok = 0;
      };
      i = i + 1;
    };
    ok
  }

  // -------------------------------------------------------------
  // Probes -- each calls the real extern-C thunk via stdlib_lowering,
  // then byte-compares the output against the pinned KAT constant.
  // Returns 1 (pass) or 0 (fail); never panics/traps on mismatch.
  // -------------------------------------------------------------

  let run_argon2id_probe : () -> u64 !{crypto, mem, RawMem} @{paideia.crypto, paideia.raw_mem} = fn(_: ()) -> {
    let rc : i64 = Argon2id::derive(&argon2id_params, &argon2id_out, 32);
    if rc == 0 {
      bytes_eq(&argon2id_out, &RFC_9106_ARGON2ID_TAG, 32)
    } else {
      0
    }
  }

  let run_chacha_seal_probe : () -> u64 !{crypto, mem, RawMem} @{paideia.crypto, paideia.raw_mem} = fn(_: ()) -> {
    let rc : i64 = ChaCha20Poly1305::seal(
      &chacha_aead_params,
      &RFC_8439_SEC_2_8_2_PLAINTEXT,
      114,
      &chacha_seal_out,
      130,
      &chacha_seal_written,
    );
    if rc == 0 {
      bytes_eq(&chacha_seal_out, &RFC_8439_SEC_2_8_2_SEALED, 130)
    } else {
      0
    }
  }

  let run_chacha_open_probe : () -> u64 !{crypto, mem, RawMem} @{paideia.crypto, paideia.raw_mem} = fn(_: ()) -> {
    let rc : i64 = ChaCha20Poly1305::open(
      &chacha_aead_params,
      &RFC_8439_SEC_2_8_2_SEALED,
      130,
      &chacha_open_out,
      114,
      &chacha_open_written,
    );
    if rc == 0 {
      bytes_eq(&chacha_open_out, &RFC_8439_SEC_2_8_2_PLAINTEXT, 114)
    } else {
      0
    }
  }

  let run_kem_keygen_probe : () -> u64 !{crypto, mem, RawMem} @{paideia.crypto, paideia.raw_mem} = fn(_: ()) -> {
    let rc : i64 = MlKem768::keygen(&ACVP_KG_D, &ACVP_KG_Z, &kem_kg_ek, &kem_kg_dk);
    if rc == 0 {
      if bytes_eq(&kem_kg_ek, &ACVP_KG_EK, 1184) == 1 {
        bytes_eq(&kem_kg_dk, &ACVP_KG_DK, 2400)
      } else {
        0
      }
    } else {
      0
    }
  }

  let run_kem_encaps_probe : () -> u64 !{crypto, mem, RawMem} @{paideia.crypto, paideia.raw_mem} = fn(_: ()) -> {
    let rc : i64 = MlKem768::encaps(&ACVP_EN_EK, &ACVP_EN_M, &kem_en_c, &kem_en_k);
    if rc == 0 {
      if bytes_eq(&kem_en_c, &ACVP_EN_C, 1088) == 1 {
        bytes_eq(&kem_en_k, &ACVP_EN_K, 32)
      } else {
        0
      }
    } else {
      0
    }
  }

  let run_kem_decaps_probe : () -> u64 !{crypto, mem, RawMem} @{paideia.crypto, paideia.raw_mem} = fn(_: ()) -> {
    let rc : i64 = MlKem768::decaps(&ACVP_DE_DK, &ACVP_DE_C, &kem_de_k);
    if rc == 0 {
      bytes_eq(&kem_de_k, &ACVP_DE_K, 32)
    } else {
      0
    }
  }

