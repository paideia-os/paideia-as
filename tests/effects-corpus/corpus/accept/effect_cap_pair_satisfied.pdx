// paideia-as#1307 (paideia-os R29.M2-002 #1024 positive companion) —
// effect row `!{Mmio}` paired with matching capability `@{paideia.mmio}`.
// The elaborator's effect_cap_coupling walker (crates/paideia-as-
// elaborator/src/effect_cap_coupling.rs) must accept this fixture:
// the effect `Mmio` requires `paideia.mmio` per BINDINGS in
// paideia-as-effects::effect_cap_binding, and the cap is present.

module EffectCapPairSatisfied = structure {
  effect Mmio {
    op mmio_read : (u32) -> u64
  }

  let driver_ok : (u32) -> u64 !{Mmio} @{paideia.mmio} =
    fn (addr : u32) -> perform Mmio::mmio_read(addr)
}
