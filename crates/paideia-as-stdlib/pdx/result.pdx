// Phase 4 m11-001 (v0.18 #997): Result<T, E> sum type + methods.
//
// Result<T, E> represents the result of an operation that may succeed or fail.
// Every Result<T, E> is either Ok(value) or Err(error).
//
// Generic enum declaration:
enum Result<T, E> {
  Ok(T),
  Err(E),
}

