// v0.18 #998: Modified stub — str_starts_with_true.
//
// Verify that str_starts_with returns true when a Str starts with a prefix.
// Phase-4-m11-003 minimum: parse-only. Updated to align on Str { ptr: *u8, len: u64 } (v0.18 #998).
// Implementation blocked on #998b (deref), #998c (loop).

struct Str {
  ptr: *u8,
  len: u64,
}

trait StrStartsWith {
  fn str_starts_with(s: Str, prefix: Str) -> bool;
}
