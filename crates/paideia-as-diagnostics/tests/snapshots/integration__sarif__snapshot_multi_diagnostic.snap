            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "Phase 8 m1-004: during binary emission (ELF or PE), the encoder encountered a non-fatal warning condition. The emission continues, but this diagnostic should be reviewed. Use --sarif to capture details for analysis."
              },
              "helpUri": "https://paideia-os.org/diagnostics/B1706",
              "id": "B1706",
