//! #1200: flat-lambda BinOp canary: division with prior let binding RDX
//! Pattern: let x = a & b; x / c (exercises RDX save/restore if x is bound to RDX)
//! After #1200 (division support), this computes (36 & 45) / 6 = 36 / 6 = 6.

module FlatLambdaBinopDivVarVarRdxLive = structure {
  let compute : (u64, u64, u64) -> u64 =
    fn (a: u64) (b: u64) (c: u64) -> {
      let x = a & b
      x / c
    }

  pub let entry : () -> u64 =
    fn () -> compute(36, 45, 6)
}
