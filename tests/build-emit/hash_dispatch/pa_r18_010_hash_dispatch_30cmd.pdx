  pub let entry : () -> u64 !{} @{} = fn(_: ()) -> unsafe {
    effects: {},
    capabilities: {},
    justification: "Hash dispatch entry point for 30 commands",
    block: {
      mov rdi, 0x1de21a9123d4fb41
      lea rsi, [rip + handle_cmd0]
      call hashmap_u64_put
      mov rdi, 0x1de2199123d4f98e
      lea rsi, [rip + handle_cmd1]
      call hashmap_u64_put
      mov rdi, 0x1de2189123d4f7db
      lea rsi, [rip + handle_cmd2]
      call hashmap_u64_put
      mov rdi, 0x1de2179123d4f628
      lea rsi, [rip + handle_cmd3]
      call hashmap_u64_put
      mov rdi, 0x1de21e9123d5020d
      lea rsi, [rip + handle_cmd4]
      call hashmap_u64_put
      mov rdi, 0x1de21d9123d5005a
      lea rsi, [rip + handle_cmd5]
      call hashmap_u64_put
      mov rdi, 0x1de21c9123d4fea7
      lea rsi, [rip + handle_cmd6]
      call hashmap_u64_put
      mov rdi, 0x1de21b9123d4fcf4
      lea rsi, [rip + handle_cmd7]
      call hashmap_u64_put
      mov rdi, 0x1de2129123d4eda9
      lea rsi, [rip + handle_cmd8]
      call hashmap_u64_put
      mov rdi, 0x1de2119123d4ebf6
      lea rsi, [rip + handle_cmd9]
      call hashmap_u64_put
      mov rdi, 0x9c2b2f9fe2e45dda
      lea rsi, [rip + handle_cmd10]
      call hashmap_u64_put
      mov rdi, 0x9c2b309fe2e45f8d
      lea rsi, [rip + handle_cmd11]
      call hashmap_u64_put
      mov rdi, 0x9c2b2d9fe2e45a74
      lea rsi, [rip + handle_cmd12]
      call hashmap_u64_put
      mov rdi, 0x9c2b2e9fe2e45c27
      lea rsi, [rip + handle_cmd13]
      call hashmap_u64_put
      mov rdi, 0x9c2b2b9fe2e4570e
      lea rsi, [rip + handle_cmd14]
      call hashmap_u64_put
      mov rdi, 0x9c2b2c9fe2e458c1
      lea rsi, [rip + handle_cmd15]
      call hashmap_u64_put
      mov rdi, 0x9c2b299fe2e453a8
      lea rsi, [rip + handle_cmd16]
      call hashmap_u64_put
      mov rdi, 0x9c2b2a9fe2e4555b
      lea rsi, [rip + handle_cmd17]
      call hashmap_u64_put
      mov rdi, 0x9c2b279fe2e45042
      lea rsi, [rip + handle_cmd18]
      call hashmap_u64_put
      mov rdi, 0x9c2b289fe2e451f5
      lea rsi, [rip + handle_cmd19]
      call hashmap_u64_put
      mov rdi, 0x9c27a99fe2e14451
      lea rsi, [rip + handle_cmd20]
      call hashmap_u64_put
      mov rdi, 0x9c27a89fe2e1429e
      lea rsi, [rip + handle_cmd21]
      call hashmap_u64_put
      mov rdi, 0x9c27a79fe2e140eb
      lea rsi, [rip + handle_cmd22]
      call hashmap_u64_put
      mov rdi, 0x9c27a69fe2e13f38
      lea rsi, [rip + handle_cmd23]
      call hashmap_u64_put
      mov rdi, 0x9c27ad9fe2e14b1d
      lea rsi, [rip + handle_cmd24]
      call hashmap_u64_put
      mov rdi, 0x9c27ac9fe2e1496a
      lea rsi, [rip + handle_cmd25]
      call hashmap_u64_put
      mov rdi, 0x9c27ab9fe2e147b7
      lea rsi, [rip + handle_cmd26]
      call hashmap_u64_put
      mov rdi, 0x9c27aa9fe2e14604
      lea rsi, [rip + handle_cmd27]
      call hashmap_u64_put
      mov rdi, 0x9c27a19fe2e136b9
      lea rsi, [rip + handle_cmd28]
      call hashmap_u64_put
      mov rdi, 0x9c27a09fe2e13506
      lea rsi, [rip + handle_cmd29]
      call hashmap_u64_put

      // Look up cmd14 by hash
      mov rdi, 0x9c2b2b9fe2e4570e
      call hashmap_u64_get

      // rax = discriminant (0=Some, 1=None); rdx = handler address
      cmp rax, 0
      jne dispatch_miss

      // Success: call the handler for cmd14
      xor rdi, rdi
      call rdx
      jmp dispatch_done

      dispatch_miss:
      mov rax, 999

      dispatch_done:
      ret
    }
