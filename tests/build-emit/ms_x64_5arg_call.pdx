// v0.21-001 (#1277, closes #1011): MS x64 caller-side 5-arg call.
//
// Regression fixture for the missing MS x64 stack-passing emit path.
// Prior to v0.21-001, a paideia caller passing 5+ args to an @abi("ms")
// callee fired T0521 and dropped the extra args. This fixture calls a
// 5-arg MS callee with a mix of Var + Literal source shapes and expects:
//
//   1. `sub rsp, 56` — the caller's 32-byte shadow area (MS ABI required)
//      + one 8-byte slot for arg[4] + one 8-byte alignment pad (odd stack
//      arg count).
//   2. `mov qword ptr [rsp + 32], 5` — arg[4] materialised into the stack
//      slot above the shadow area; callee sees this at [rsp + 40] after
//      the CALL push.
//   3. `call uefi_5arg`.
//   4. `add rsp, 56` — matches the prelude.
//
// arg[0]=base (u64, Var), arg[1..3] literals, arg[4]=5 (literal).
// The callee is a leaf that returns arg[0] via `mov rax, rcx; ret`
// (unchanged from the ms_x64_shadow fixture — the callee-side path is
// exercised by that test).

module MsX645ArgCall = structure {
  pub let uefi_5arg : (u64, u64, u64, u64, u64) -> u64 =
    fn(a : u64, b : u64, c : u64, d : u64, e : u64) -> a @abi("ms")

  pub let caller_5arg : (u64) -> u64 =
    fn(base : u64) -> uefi_5arg(base, 2, 3, 4, 5)
}
