            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Issue #1012: A @guid compile-time directive has an invalid GUID string. GUID syntax is XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX (36 characters with dashes at positions 8, 13, 18, 23; all other characters must be hexadecimal). Verify the string is 36 characters, dashes are in the correct positions, and all hex characters are valid (0-9, a-f, A-F)."
              },
              "helpUri": "https://paideia-os.org/diagnostics/P0278",
              "id": "P0278",
              "name": "Malformed GUID literal",
              "shortDescription": {
                "text": "@guid literal malformed (wrong length, invalid dashes, non-hex characters)"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Issue #1013: The @include_bytes compile-time directive encountered an error resolving or reading the file. Common causes: empty path, absolute path (only relative paths allowed), file not found, permission denied, or path is not a regular file. Verify the path is relative, the file exists, and the file is readable."
              },
              "helpUri": "https://paideia-os.org/diagnostics/P0279",
              "id": "P0279",
              "name": "@include_bytes path error",
              "shortDescription": {
                "text": "@include_bytes path is invalid, not found, or inaccessible"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Issue #1013: The file referenced by @include_bytes is larger than the 16 MiB size limit for compile-time embeds. This limit is enforced to prevent accidentally embedding very large files during compilation. Split the data into smaller files or use a different approach (e.g., external file references) for larger payloads."
              },
              "helpUri": "https://paideia-os.org/diagnostics/P0280",
              "id": "P0280",
              "name": "@include_bytes file too large",
              "shortDescription": {
                "text": "@include_bytes file exceeds 16 MiB limit"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Issue #1014: The @include_str directive requires the referenced file to be valid UTF-8. The file contains an invalid UTF-8 byte sequence at the indicated byte offset. Use @include_bytes_as_str instead if you need to embed binary data without UTF-8 validation."
              },
              "helpUri": "https://paideia-os.org/diagnostics/P0281",
              "id": "P0281",
              "name": "@include_str file is not valid UTF-8",
              "shortDescription": {
                "text": "@include_str: file is not valid UTF-8"
