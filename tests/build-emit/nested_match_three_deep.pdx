// Issue #1214: three levels of nested matches with wildcards
// Tests that deeply nested matches all with wildcard arms correctly
// resolve labels at each cascade level.
// Expected exit code: 7

module NestedMatchThreeDeep = structure {
  enum Outcome { Success, Failure, Retry }
  pub let entry : () -> u64 !{} @{} = fn(_: ()) -> {
    let level1 : Outcome = Outcome::Retry
    match level1 {
      Success => 1u64
      Failure => 2u64
      _ => {
        let level2 : Outcome = Outcome::Retry
        match level2 {
          Success => 3u64
          Failure => 4u64
          _ => {
            let level3 : Outcome = Outcome::Success
            match level3 {
              Success => 7u64
              Failure => 5u64
              _ => 6u64
            }
          }
        }
      }
    }
  }
}
