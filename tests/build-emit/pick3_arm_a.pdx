// Issue #1199 + #1204: 3-arm enum-match cmp/jne cascade — arm A (unit variants)
// Tests that match arms with 3 unit-variant enum patterns emit dispatch code with cmp/jne cascade.
// Also exercises #1204 fix: bare enum literal in module-let binding emits correct data symbol.
// Expected exit code: 10

module Pick3ArmA = structure {
  enum Choice { A, B, C }
  pub let c : Choice = Choice::A
  pub let entry : () -> u64 !{} @{} = fn(_: ()) -> match c {
    A => 10u64
    B => 20u64
    C => 30u64
  }
}
