// Issue #1210: Integer-scrutinee match with literal scrutinee 1u64
// Tests basic integer match with literal 1u64 matching second arm.
// Expected exit code: 20

module IntmatchLitOne = structure {
  pub let entry : () -> u64 !{} @{} = fn(_: ()) ->
    match 1u64 {
      0u64 => 10u64
      _ => 20u64
    }
}
