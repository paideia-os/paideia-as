//! #1196: flat-lambda BinOp canary: (Var, Literal) subtraction
//! Pattern: fn (v) -> v - 5
//! Before #1196: silently miscompiled as v + 5
//! After #1196: correctly emits SUB instruction via shared lowerer

module FlatLambdaBinopSubVarLit = structure {
  let compute : (u64) -> u64 =
    fn (v: u64) -> v - 5

  pub let entry : () -> u64 =
    fn () -> compute(12)
}
